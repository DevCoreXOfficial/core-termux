#!/data/data/com.termux/files/usr/bin/bash
# cursor wrapper - termux-glibc loader + proot syscall emulation

unset LD_PRELOAD
unset LD_LIBRARY_PATH

GLIBC_LOADER="/data/data/com.termux/files/usr/glibc/lib/ld-linux-aarch64.so.1"
GLIBC_LIB="/data/data/com.termux/files/usr/glibc/lib"
TOOL_DATA_DIR="__DATA_DIR__"

if [ ! -f "$GLIBC_LOADER" ] || [ ! -f "$TOOL_DATA_DIR/node" ]; then
  echo "Error: termux-glibc or cursor binary not found" >&2
  echo "Run: pkg install glibc" >&2
  exit 1
fi


export GODEBUG="netdns=cgo"
export SSL_CERT_FILE="/data/data/com.termux/files/usr/etc/tls/cert.pem"
export CURSOR_INVOKED_AS="${0##*/}"
export HOST="${HOST:-127.0.0.1}"
if [ -z "${BROWSER:-}" ] && command -v termux-open-url &>/dev/null; then
  BROWSER="termux-open-url"
fi
export BROWSER

exec proot -r / \
  -b /dev:/dev -b /proc:/proc -b /sys:/sys \
  -b "$GLIBC_LIB:/lib" \
  -b "$PREFIX/bin:/bin" \
  "$TOOL_DATA_DIR/node" \
  "$TOOL_DATA_DIR/index.js" \
  "$@"
