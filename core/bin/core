#!/usr/bin/env bash

# Core - multiplatform entrypoint.
# #!/usr/bin/env bash works on Termux, Ubuntu Linux and Ubuntu (WSL).

SOURCE="${BASH_SOURCE[0]}"

# resolve symlink if present
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done

BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# project root
CORE_PATH="$(cd "$BIN_DIR/.." && pwd)"
export CORE_PATH

# load bootstrap
source "$CORE_PATH/utils/bootstrap.sh"

# load environment
import "@/utils/env"
export CORE_PATH CORE_CONFIG CORE_CACHE CORE_DATA CORE_VERSION

# ===== PLATFORM DETECTION =====
import "@/lib/platform"
core_detect_platform

if ! core_platform_supported; then
  echo
  echo "  core: unsupported environment detected ($(core_platform_label))."
  echo "  Supported platforms: Termux/Android, Ubuntu Linux, Ubuntu (WSL)."
  echo
  exit 1
fi

# ===== CHECK UPDATES =====
CORE_REMOTE_VERSION_URL="https://raw.githubusercontent.com/DevCoreXOfficial/core/main/core/utils/env.sh"

check_for_updates() {
  local version_file="$CORE_CACHE/last_version_check"
  local current_time=$(date +%s)
  local check_interval=86400 # 24 hours in seconds
  local last_check=0

  if [[ -f "$version_file" ]]; then
    last_check=$(cat "$version_file" 2>/dev/null | head -1)
  fi

  if ((current_time - last_check < check_interval)); then
    return 0
  fi

  mkdir -p "$CORE_CACHE"
  echo "$current_time" >"$version_file"

  (
    local remote_version
    remote_version=$(curl -fsSL "$CORE_REMOTE_VERSION_URL" 2>/dev/null | grep "CORE_VERSION=" | cut -d'"' -f2)
    local local_version="$CORE_VERSION"

    # Notify only when the remote version is NEWER than the local one.
    if [[ -n "$remote_version" ]] && [[ "$remote_version" != "$local_version" ]]; then
      local highest
      highest=$(printf '%s\n%s\n' "$local_version" "$remote_version" | sort -V | tail -1)
      [[ "$highest" == "$remote_version" ]] && echo "$remote_version" >"$CORE_CACHE/new_version"
    fi
  ) &>/dev/null &
}

show_update_notification() {
  local new_version_file="$CORE_CACHE/new_version"

  if [[ -f "$new_version_file" ]]; then
    local new_version
    new_version=$(cat "$new_version_file")
    echo
    separator_section "Update Available"
    echo
    log_warn "New version available: ${D_GREEN}$new_version${D_NC} (current: ${D_CYAN}$CORE_VERSION${D_NC})"
    echo
    list_item "Run: ${D_CYAN}core update core${D_NC} to update"
    echo
  fi
}

if [[ "$1" != "update" ]] && [[ "$1" != "uninstall" ]] && [[ "$1" != "reinstall" ]]; then
  check_for_updates

  import "@/utils/log"
  import "@/utils/colors"

  show_update_notification
fi

# load CLI
import "@/cli/core"

core_main "$@"
